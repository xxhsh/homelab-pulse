# /etc/homelab-pulse/env  (root:pulse 640). Restart after editing: systemctl restart homelab-pulse
#
# Proxmox: "live" (read-only API token) or "demo" (a simulated two-node cluster).
PULSE_PVE=demo
# Any node of the cluster; its name (for TLS) is detected automatically.
PULSE_PVE_HOST=
PULSE_PVE_PORT=8006
# Token file, one line "user@realm!tokenid=secret" (PVEAuditor role is enough).
PULSE_PVE_TOKEN_FILE=/etc/homelab-pulse/pve-token
# Cluster CA (/etc/pve/pve-root-ca.pem on any node). Proxmox's TLS is verified against it.
PULSE_PVE_CA=/etc/homelab-pulse/pve-ca.pem
# Only if the node's certificate isn't issued for its node name:
#PULSE_PVE_TLS_NAME=
#
# Extra standalone Proxmox hosts (not in this cluster): one <name>.env per host, written by
# `homelab-pulse-hosts add` (see add-host.sh). Clusters need nothing here.
#PULSE_PVE_HOSTS_DIR=/etc/homelab-pulse/hosts.d
#
# Optional tweaks on top of discovery (see overrides.example.json).
PULSE_OVERRIDES=/etc/homelab-pulse/overrides.json
#
# Alerts, history and settings (1.1). The database lives in systemd's StateDirectory by default.
#PULSE_DB=/var/lib/homelab-pulse/pulse.db
PULSE_ADMIN_PASSWORD_FILE=/etc/homelab-pulse/admin-password
# Address used for links in notifications (default: http://<container IP>/)
#PULSE_PUBLIC_URL=
#
PULSE_PORT=80
PULSE_BIND=0.0.0.0
PULSE_LOG=INFO
